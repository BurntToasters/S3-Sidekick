# GitHub releases use the GitHub CLI credential store. Run `gh auth login` on
# each release VM; no GitHub token belongs in this file.

GPG_KEY_ID=
GPG_PASSPHRASE=

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust)
# Once per Windows release VM (as Administrator), run: npm run setup:win:release
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

APPLE_SIGNING_IDENTITY=
# Required keychain profile used by `xcrun notarytool`; create it on each
# macOS release host before packaging.
APPLE_NOTARY_PROFILE=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
SSH_USER_PWD=

# Stable releases (npm run r && npm run release:[os]) copy cleaned artifacts here
# and refuse to finalize if this is unset. Beta versions (X.Y.Z-beta.N) skip this
# mirror unless OVERRIDE_BETA_MIRROR_SKIP=1.
AFTER_PACK_LOC=
# Unused by default. Set to 1 only to force AFTER_PACK_LOC mirroring for a beta release.
# OVERRIDE_BETA_MIRROR_SKIP=
# Unused by default. Set to 1 only to finalize a stable release without copying.
# SKIP_RELEASE_MIRROR=

# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=S3-Sidekick

# Required on the draft coordinator. This exact immediate public predecessor is
# signed into the descriptor and every install/update smoke report must match it.
# RELEASE_INSTALL_SMOKE_PREVIOUS_VERSION=0.11.0-beta.4

# Required on the draft coordinator. Generate this exact compact JSON on a
# trusted Linux release host with `npm run release:flatpak-inputs`, then copy
# the value without editing it. It must pin both x64 and arm64 Flathub refs.
# RELEASE_FLATPAK_INPUTS=

# One-time, prerelease-only authorization for bootstrapping the current legacy
# GitHub Latest release into a signed stable carrier. Leave unset after the
# migration. The values must exactly match the published predecessor.
# RELEASE_LEGACY_LATEST_BOOTSTRAP={"schemaVersion":1,"releaseId":354185192,"tag":"v0.10.2","sourceCommit":"cabdce4f9466c3a7dd1123b8a4403e97e27f16c4"}

# Recovery only: exact 1 permits explicit adoption of an existing owner from
# complete signed remote transaction/rollover/receipt evidence. Prefer the
# one-shot `npm run release:publish -- --takeover-publication-owner` flag.
# RELEASE_PUBLICATION_TAKEOVER=0