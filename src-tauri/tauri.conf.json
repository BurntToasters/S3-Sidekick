{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3 Sidekick",
  "version": "0.11.0",
  "identifier": "run.rosie.s3-sidekick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S3 Sidekick",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.github.com https://github.com;"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Desktop client for S3-compatible object storage",
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/windows-artifact-sign.ps1",
          "-FilePath",
          "%1"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/BurntToasters/S3-Sidekick/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMDM0ODVCRjcxRjhBQjQKUldTMGloLzNXMGdERTEzUmc2Y3BkVEJFMlRIMGpzaE9Ud1oxcUNpRitnS3Z5MkVRa0thdi9PNUwK"
    }
  }
}
